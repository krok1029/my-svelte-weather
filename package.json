{
	"name": "my-svelte-weather",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"start": "vite dev",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"ts:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest run",
		"test:ui": "playwright test test.ts",
		"test:weather": "playwright test weather-card.test.ts",
		"test:map": "playwright test map.test.ts",
		"test:api": "playwright test api.test.ts",
		"test:headed": "playwright test --headed",
		"test:debug": "playwright test --debug",
		"test:report": "playwright show-report",
		"test:install": "playwright install",
		"test:unit:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"@types/leaflet": "^1.9.22",
		"@types/lodash": "^4.17.25",
		"@types/node": "^24.19.0",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"autoprefixer": "^10.6.1",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"postcss": "^8.5.28",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"type": "module",
	"packageManager": "yarn@4.18.1",
	"dependencies": {
		"axios": "^1.20.0",
		"leaflet": "^1.9.4",
		"lodash": "^4.18.1",
		"mode-watcher": "^1.1.0"
	},
	"engines": {
		"node": "24.x"
	}
}
